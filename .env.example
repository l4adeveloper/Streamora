# Copy variables to the relevant app's .env.local or export to the shell.
WEB_ORIGIN=http://127.0.0.1:3000
API_PORT=4000
REALTIME_PORT=4001
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api
NEXT_PUBLIC_REALTIME_URL=http://127.0.0.1:4001
NEXT_PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880
# Infrastructure placeholders; choose local development passwords.
POSTGRES_PASSWORD=replace-with-local-password
RABBITMQ_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://streamora:replace-with-local-password@127.0.0.1:5432/streamora
REDIS_URL=redis://127.0.0.1:6379
RABBITMQ_URL=amqp://streamora:replace-with-local-password@127.0.0.1:5672
# Keep LiveKit, AWS and GCS server credentials outside NEXT_PUBLIC_* variables.
