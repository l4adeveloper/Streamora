# Template only: inject these values using your deployment's environment/secrets.
# Staging runs with NODE_ENV=production. Both public endpoints must use HTTPS.
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4000
# Enable only if the team's staging API docs should be reachable.
API_DOCS_ENABLED=false
WEB_ORIGIN=https://app.staging.streamora.example

ACCESS_TOKEN_SECRET=replace-with-staging-secret-at-least-32-random-bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=true
# app.staging.streamora.example and api.staging.streamora.example are same-site.
# Use none only for genuinely different sites; third-party cookie blocking can still apply.
AUTH_COOKIE_SAME_SITE=lax

DATABASE_URL="postgresql://replace-with-staging-db-user:replace-with-staging-db-password@replace-with-staging-db-host:5432/replace-with-staging-db?sslmode=require"
