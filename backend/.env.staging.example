# Template only: inject these values using your deployment's environment/secrets.
# Staging runs with NODE_ENV=production. Both public endpoints must use HTTPS.
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4000
# Enable only if the team's staging API docs should be reachable.
API_DOCS_ENABLED=false
FILES_S3_BUCKET=
FILES_STORAGE_DRIVER=s3
FILES_S3_REGION=ap-southeast-1
FILES_DOWNLOAD_TTL_SECONDS=60
FILES_CLEANUP_ENABLED=true
# T13: fill AWS resources using docs/t13-aws-console.md before enabling.
# VIDEO_MODE=aws
# VIDEO_WORKER_ENABLED=true
# VIDEO_AWS_ACCOUNT_ID=
# VIDEO_MAX_QUALITY=1080
# VIDEO_DYNAMODB_TABLE=streamora-video-jobs
# VIDEO_OUTPUT_BUCKET=
# VIDEO_MEDIA_DOMAIN=
# Worker runs inside streamora-api; see docs/t13-aws-console.md for service-account credentials.
WEB_ORIGIN=https://app.staging.streamora.example

# T21: the EC2 IAM role reads this secret in AWS_REGION.
REALTIME_PROVIDER=azure
AZURE_WEB_PUBSUB_SECRET_ID=streamora/staging/azure-web-pubsub

ACCESS_TOKEN_SECRET=replace-with-staging-secret-at-least-32-random-bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=true
# app.staging.streamora.example and api.staging.streamora.example are same-site.
# Use none only for genuinely different sites; third-party cookie blocking can still apply.
AUTH_COOKIE_SAME_SITE=lax

DATABASE_URL="postgresql://replace-with-staging-db-user:replace-with-staging-db-password@replace-with-staging-db-host:5432/replace-with-staging-db?sslmode=require"

# T05: inject both keys through deployment secrets, or leave both empty for EC2 IAM role.
IVS_ENABLED=false
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials:
# AWS_SESSION_TOKEN=
IVS_TOKEN_TTL_SECONDS=60
IVS_EVENTS_QUEUE_URL=
IVS_WORKER_ENABLED=false

# Automatic captions for classroom recordings.
# Supply the Azure Speech resource key through the backend environment or deployment secrets.
AZURE_SPEECH_REGION=
AZURE_SPEECH_KEY=
# One locale or up to four different languages for detection at the start.
AZURE_SPEECH_LOCALES=vi-VN,en-US
# Leave blank to use the FFmpeg binary installed by npm.
RECORDING_FFMPEG_PATH=
