  "info": {
    "title": "Streamora T03 — thành viên và quyền nhóm",
    "description": "T03-01 đến T03-06. T03-07: membership.changed tại namespace /classroom, chỉ tới user bị tác động; reconnect đọc permissions/me. Email thành viên hiển thị theo yêu cầu giao diện.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "accessToken": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ValidationIssueDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "fullName"
          },
          "code": {
            "type": "object",
            "example": "INVALID_LENGTH"
          },
          "message": {
            "type": "string",
            "example": "Họ tên phải có từ 1 đến 100 ký tự."
          }
        },
        "required": ["field", "code", "message"]
      },
      "ErrorDetailsDto": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationIssueDto"
            }
          }
        }
      },
      "ErrorBodyDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "example": "Dữ liệu yêu cầu không hợp lệ."
          },
          "details": {
            "$ref": "#/components/schemas/ErrorDetailsDto"
          }
        },
        "required": ["code", "message"]
      },
      "ApiErrorResponseDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyDto"
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "description": "Trùng header X-Request-ID của response."
          }
        },
        "required": ["error", "requestId"]
      },
      "LookupUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": ["id", "fullName", "email"]
      },
      "UserLookupResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/LookupUserDto"
              }
            ]
          }
        },
        "required": ["user"]
      },
      "MembershipDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Hiển thị cho thành viên của nhóm theo yêu cầu giao diện T03."
          },
          "role": {
            "type": "string",
            "enum": ["OWNER", "HOST", "VIEWER"]
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["userId", "fullName", "email", "role", "joinedAt"]
      },
      "MembershipListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MembershipDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": ["items", "nextCursor"]
      },
      "AddMemberDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": ["HOST", "VIEWER"]
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["role", "userId"],
        "additionalProperties": false
      },
      "MembershipResponseDto": {
        "type": "object",
        "properties": {
          "membership": {
            "$ref": "#/components/schemas/MembershipDto"
          }
        },
        "required": ["membership"]
      },
      "ChangeMemberRoleDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": ["HOST", "VIEWER"]
          }
        },
        "required": ["role"],
        "additionalProperties": false
      },
      "GroupPermissionsDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": ["ADMIN", "OWNER", "HOST", "VIEWER"]
          },
          "canManageMembers": {
            "type": "boolean"
          },
          "canHost": {
            "type": "boolean"
          },
          "canUpload": {
            "type": "boolean"
          },
          "canViewRecordings": {
            "type": "boolean"
          }
        },
        "required": [
          "role",
          "canManageMembers",
          "canHost",
          "canUpload",
          "canViewRecordings"
        ]
      }
    }
  }
}
