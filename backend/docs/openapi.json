  "info": {
    "title": "Streamora T01 — tài khoản và phiên",
    "description": "Sáu API T01. Access token giữ trong bộ nhớ; refresh cookie HttpOnly xoay vòng, hạn tuyệt đối, reuse thu hồi family. POST auth yêu cầu Origin=WEB_ORIGIN. Swagger trên host API chỉ cho Try it out GET/PATCH bằng Bearer; thử POST auth qua frontend hoặc hướng dẫn PowerShell. Swagger không tự refresh phiên.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Auth",
      "description": "Đăng ký, đăng nhập và quản lý refresh session."
    },
    {
      "name": "Users",
      "description": "Hồ sơ của user đã xác thực."
    }
  ],
  "servers": [
    {
      "url": "/",
      "description": "Host API đang phục vụ tài liệu; paths đã bao gồm /api/v1."
    }
  ],
  "components": {
    "securitySchemes": {
      "accessToken": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Access token từ login/refresh. Không dán refresh token."
      },
      "refreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refreshToken",
        "description": "Cookie HttpOnly do browser quản lý; không nhập/lưu token này vào Swagger."
      }
    },
    "schemas": {
      "ValidationIssueDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "fullName"
          },
          "code": {
            "type": "object",
            "example": "INVALID_LENGTH"
          },
          "message": {
            "type": "string",
            "example": "Họ tên phải có từ 1 đến 100 ký tự."
          }
        },
        "required": ["field", "code", "message"]
      },
      "ErrorDetailsDto": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationIssueDto"
            }
          }
        }
      },
      "ErrorBodyDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "example": "Dữ liệu yêu cầu không hợp lệ."
          },
          "details": {
            "$ref": "#/components/schemas/ErrorDetailsDto"
          }
        },
        "required": ["code", "message"]
      },
      "ApiErrorResponseDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyDto"
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "description": "Trùng header X-Request-ID của response."
          }
        },
        "required": ["error", "requestId"]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "user@example.test",
            "description": "Trim/lowercase trước khi lưu; unique."
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "minLength": 12,
            "maxLength": 128,
            "description": "Giữ nguyên khoảng trắng và Unicode. Không log giá trị."
          },
          "fullName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Nguyễn Minh Anh",
            "description": "Trim, đếm Unicode code point."
          }
        },
        "required": ["email", "password", "fullName"],
        "additionalProperties": false
      },
      "GlobalRole": {
        "type": "string",
        "enum": ["USER", "ADMIN"]
      },
      "PublicUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "d9c0fb32-dc39-4c7e-8652-c30e9fc4135e"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "user@example.test"
          },
          "fullName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Nguyễn Minh Anh"
          },
          "globalRole": {
            "allOf": [
              {
                "$ref": "#/components/schemas/GlobalRole"
              }
            ]
          }
        },
        "required": ["id", "email", "fullName", "globalRole"]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/PublicUserDto"
          }
        },
        "required": ["user"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "user@example.test"
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": ["email", "password"],
        "additionalProperties": false
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT ngắn hạn. Chỉ giữ trong bộ nhớ client.",
            "readOnly": true
          },
          "expiresIn": {
            "type": "integer",
            "minimum": 1,
            "example": 900,
            "description": "Thời gian sống access token, tính bằng giây theo cấu hình server."
          },
          "user": {
            "$ref": "#/components/schemas/PublicUserDto"
          }
        },
        "required": ["accessToken", "expiresIn", "user"]
      },
      "AccessTokenResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT ngắn hạn. Chỉ giữ trong bộ nhớ client.",
            "readOnly": true
          },
          "expiresIn": {
            "type": "integer",
            "minimum": 1,
            "example": 900,
            "description": "Thời gian sống access token, tính bằng giây theo cấu hình server."
          }
        },
        "required": ["accessToken", "expiresIn"]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Nguyễn Minh Anh",
            "description": "Chỉ nhận fullName; trim trước khi lưu."
          }
        },
        "required": ["fullName"],
        "additionalProperties": false
      }
    }
  }
}
