NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Development defaults true. Test/production default false.
API_DOCS_ENABLED=true
REALTIME_PORT=4001
WEB_ORIGIN=http://127.0.0.1:3000

# Generated by npm run setup:env. Server only, at least 32 random bytes.
ACCESS_TOKEN_SECRET=replace-with-generated-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# PostgreSQL server riêng (không dùng Docker). Lấy URL thật từ nhóm; không commit mật khẩu.
# Ký tự đặc biệt trong mật khẩu phải URL-encode.
DATABASE_URL="postgresql://replace-with-db-user:replace-with-db-password@replace-with-db-host:5432/replace-with-db?sslmode=require"

# T15: local files for development; select s3 when the bucket is available.
FILES_STORAGE_DRIVER=local
FILES_LOCAL_DIRECTORY=.local-storage/files
FILES_PUBLIC_BASE_URL=http://127.0.0.1:4000
FILES_S3_BUCKET=
FILES_S3_REGION=ap-southeast-1
FILES_DOWNLOAD_TTL_SECONDS=120
FILES_CLEANUP_ENABLED=true

# T05: IVS Real-Time. Enable only after AWS credentials/IAM are configured.
IVS_ENABLED=false
AWS_REGION=ap-northeast-1
# Server only: fill both values. AWS_PROFILE and AWS CLI setup are not required.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials:
# AWS_SESSION_TOKEN=
IVS_TOKEN_TTL_SECONDS=60
IVS_EVENTS_QUEUE_URL=
# Keep false in API when running npm run dev:ivs-events separately.
IVS_WORKER_ENABLED=false
