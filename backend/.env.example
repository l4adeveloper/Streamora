NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Development defaults true. Test/production default false.
API_DOCS_ENABLED=true
REALTIME_PORT=4001
WEB_ORIGIN=http://127.0.0.1:3000

# Generated by npm run setup:env. Server only, at least 32 random bytes.
ACCESS_TOKEN_SECRET=replace-with-generated-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# PostgreSQL server riêng (không dùng Docker). Lấy URL thật từ nhóm; không commit mật khẩu.
# Ký tự đặc biệt trong mật khẩu phải URL-encode.
DATABASE_URL="postgresql://replace-with-db-user:replace-with-db-password@replace-with-db-host:5432/replace-with-db?sslmode=require"

# Server-only. Required when registered group rooms are connected to LiveKit.
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
