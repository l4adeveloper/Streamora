NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Development defaults true. Test/production default false.
API_DOCS_ENABLED=true
REALTIME_PORT=4001
WEB_ORIGIN=http://127.0.0.1:3000

# Generated by npm run setup:env. Server only, at least 32 random bytes.
ACCESS_TOKEN_SECRET=replace-with-generated-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# PostgreSQL credentials must match the root .env used by Docker Compose.
DATABASE_URL=postgresql://streamora:replace-with-local-password@127.0.0.1:5432/streamora
REDIS_URL=redis://127.0.0.1:6379
RABBITMQ_URL=amqp://streamora:replace-with-local-password@127.0.0.1:5672
