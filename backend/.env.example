NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Development defaults true. Test/production default false.
API_DOCS_ENABLED=true
REALTIME_PORT=4001
WEB_ORIGIN=http://127.0.0.1:3000

# Workspace chat: DynamoDB Local in development; omit endpoint on AWS.
CHAT_DYNAMODB_TABLE=streamora-chat
CHAT_DYNAMODB_REGION=ap-southeast-1
CHAT_DYNAMODB_ENDPOINT=http://127.0.0.1:8000

# T21: set azure to use the classroom hub. The secret stores the raw connection string.
REALTIME_PROVIDER=local
AZURE_WEB_PUBSUB_SECRET_ID=

# Generated by npm run setup:env. Server only, at least 32 random bytes.
ACCESS_TOKEN_SECRET=replace-with-generated-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# PostgreSQL server riêng (không dùng Docker). Lấy URL thật từ nhóm; không commit mật khẩu.
# Ký tự đặc biệt trong mật khẩu phải URL-encode.
DATABASE_URL="postgresql://replace-with-db-user:replace-with-db-password@replace-with-db-host:5432/replace-with-db?sslmode=require"

# T15: local files for development; select s3 when the bucket is available.
FILES_STORAGE_DRIVER=local
FILES_LOCAL_DIRECTORY=.local-storage/files
FILES_PUBLIC_BASE_URL=http://127.0.0.1:4000
FILES_S3_BUCKET=
FILES_S3_REGION=ap-southeast-1
FILES_DOWNLOAD_TTL_SECONDS=60
FILES_CLEANUP_ENABLED=true

# T05: IVS Real-Time. Enable only after AWS credentials/IAM are configured.
IVS_ENABLED=false
AWS_REGION=ap-northeast-1
# Server only: fill both values. AWS_PROFILE and AWS CLI setup are not required.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials:
# AWS_SESSION_TOKEN=
IVS_TOKEN_TTL_SECONDS=60
IVS_EVENTS_QUEUE_URL=
# Keep false in API when running npm run dev:ivs-events separately.
IVS_WORKER_ENABLED=false

# T16: local object-storage listener starts on first signed part request.
UPLOAD_LOCAL_PORT=4002
UPLOAD_MAX_SIZE_BYTES=2147483648
UPLOAD_PART_SIZE_BYTES=8388608
UPLOAD_TTL_SECONDS=86400
# Reservations are enforced on the server across tabs/API instances; completed files do not count.
UPLOAD_MAX_ACTIVE_PER_USER=4
UPLOAD_MAX_ACTIVE_PER_GROUP=32
UPLOAD_MAX_ACTIVE_BYTES_PER_USER=8589934592
UPLOAD_MAX_ACTIVE_BYTES_PER_GROUP=68719476736

# T13: local FFmpeg; AWS uses managed MediaConvert (see docs/t13-aws-console.md).
VIDEO_MODE=local
VIDEO_WORKER_ENABLED=true
VIDEO_MAX_QUALITY=1080
VIDEO_SCRATCH_DIRECTORY=.local-storage/video-scratch
# VIDEO_FFMPEG_PATH=ffmpeg
# VIDEO_FFPROBE_PATH=ffprobe
# VIDEO_OPTIONAL_QUALITIES=480,1440
# AWS API: VIDEO_MODE=aws, VIDEO_WORKER_ENABLED=false. DynamoDB Streams invokes Lambda.
# VIDEO_AWS_ACCOUNT_ID=
# VIDEO_DYNAMODB_TABLE=streamora-video-jobs
# VIDEO_OUTPUT_BUCKET=
# VIDEO_MEDIA_DOMAIN=
# VIDEO_SIGNING_SECRET_ARN=
# Configure Lambda processing settings in AWS Console; no PostgreSQL connection or DB secret in Lambda.

# Automatic captions for classroom recordings. Set both values in backend/.env to enable.
# Use the Azure Speech resource region (for example, eastasia) and its key.
AZURE_SPEECH_REGION=eastasia
AZURE_SPEECH_KEY=

# One locale or up to four different languages for detection at the start.
AZURE_SPEECH_LOCALES=vi-VN,en-US
# Leave blank to use the FFmpeg binary installed by npm.
RECORDING_FFMPEG_PATH=
