{
  "name": "@streamora/realtime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build --workspace=@streamora/api && tsc && node --env-file-if-exists=../.env dist/main.js",
    "build": "tsc",
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "socket.io": "^4.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}
