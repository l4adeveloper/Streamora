{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "T13AndBootstrapStacks",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": [
        "arn:aws:cloudformation:ap-northeast-1:586481704097:stack/StreamoraT13/*",
        "arn:aws:cloudformation:ap-northeast-1:586481704097:stack/CDKToolkit/*",
        "arn:aws:cloudformation:ap-northeast-1:586481704097:changeSet/*/*"
      ]
    },
    {
      "Sid": "TemplateAndOwnershipChecks",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ValidateTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:DescribeStackResources",
        "cloudformation:ListStacks",
        "lambda:ListEventSourceMappings",
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BootstrapResources",
      "Effect": "Allow",
      "Action": [
        "s3:*",
        "ecr:*",
        "ssm:*",
        "iam:CreateRole",
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:UpdateAssumeRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": [
        "arn:aws:s3:::cdk-hnb659fds-assets-586481704097-ap-northeast-1",
        "arn:aws:s3:::cdk-hnb659fds-assets-586481704097-ap-northeast-1/*",
        "arn:aws:ecr:ap-northeast-1:586481704097:repository/cdk-hnb659fds-container-assets-586481704097-ap-northeast-1",
        "arn:aws:ssm:ap-northeast-1:586481704097:parameter/cdk-bootstrap/hnb659fds/*",
        "arn:aws:iam::586481704097:role/cdk-hnb659fds-*-586481704097-ap-northeast-1"
      ]
    },
    {
      "Sid": "AssumeCdkRoles",
      "Effect": "Allow",
      "Action": ["sts:AssumeRole", "sts:TagSession"],
      "Resource": "arn:aws:iam::586481704097:role/cdk-hnb659fds-*-586481704097-ap-northeast-1"
    },
    {
      "Sid": "PassCloudFormationRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::586481704097:role/cdk-hnb659fds-cfn-exec-role-586481704097-ap-northeast-1",
      "Condition": { "StringEquals": { "iam:PassedToService": "cloudformation.amazonaws.com" } }
    },
    {
      "Sid": "ReadExistingBuckets",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": [
        "arn:aws:s3:::streamora-file-storage",
        "arn:aws:s3:::streamora-video-586481704097-ap-northeast-1"
      ]
    },
    {
      "Sid": "ProtectExistingOutput",
      "Effect": "Allow",
      "Action": ["s3:PutBucketPublicAccessBlock", "s3:PutBucketOwnershipControls"],
      "Resource": "arn:aws:s3:::streamora-video-586481704097-ap-northeast-1"
    },
    {
      "Sid": "InitializeT13Secrets",
      "Effect": "Allow",
      "Action": ["secretsmanager:DescribeSecret", "secretsmanager:PutSecretValue"],
      "Resource": [
        "arn:aws:secretsmanager:ap-northeast-1:586481704097:secret:streamora/video-database-*",
        "arn:aws:secretsmanager:ap-northeast-1:586481704097:secret:streamora/video-signing-*"
      ]
    },
    {
      "Sid": "CleanupManualLambda",
      "Effect": "Allow",
      "Action": ["lambda:GetFunction", "lambda:DeleteFunction"],
      "Resource": "arn:aws:lambda:ap-northeast-1:586481704097:function:streamora-video-pipeline"
    },
    {
      "Sid": "CleanupT13SqsTriggers",
      "Effect": "Allow",
      "Action": "lambda:DeleteEventSourceMapping",
      "Resource": "arn:aws:lambda:ap-northeast-1:586481704097:event-source-mapping:*",
      "Condition": {
        "ArnEquals": {
          "lambda:FunctionArn": "arn:aws:lambda:ap-northeast-1:586481704097:function:streamora-video-pipeline"
        }
      }
    },
    {
      "Sid": "CleanupManualQueuesAndRules",
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueUrl",
        "sqs:DeleteQueue",
        "mediaconvert:GetQueue",
        "mediaconvert:DeleteQueue",
        "events:DescribeRule",
        "events:DisableRule",
        "events:ListTargetsByRule",
        "events:RemoveTargets",
        "events:DeleteRule"
      ],
      "Resource": [
        "arn:aws:sqs:ap-northeast-1:586481704097:streamora-video-*",
        "arn:aws:mediaconvert:ap-northeast-1:586481704097:queues/streamora-video",
        "arn:aws:events:ap-northeast-1:586481704097:rule/streamora-video-*"
      ]
    },
    {
      "Sid": "CleanupManualRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListInstanceProfilesForRole",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:DetachRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DeleteRole"
      ],
      "Resource": [
        "arn:aws:iam::586481704097:role/streamora-video-lambda",
        "arn:aws:iam::586481704097:role/streamora-video-mediaconvert",
        "arn:aws:iam::586481704097:role/streamora-mediaconvert"
      ]
    },
    {
      "Sid": "CleanupManualLogs",
      "Effect": "Allow",
      "Action": "logs:DeleteLogGroup",
      "Resource": [
        "arn:aws:logs:ap-northeast-1:586481704097:log-group:/aws/lambda/streamora-video-pipeline",
        "arn:aws:logs:ap-northeast-1:586481704097:log-group:/aws/lambda/streamora-video-pipeline:*"
      ]
    },
    {
      "Sid": "CloudFrontDiscoveryAndLegacyObjects",
      "Effect": "Allow",
      "Action": [
        "cloudfront:ListDistributions",
        "cloudfront:ListKeyGroups",
        "cloudfront:ListPublicKeys",
        "cloudfront:ListOriginAccessControls",
        "cloudfront:ListResponseHeadersPolicies",
        "cloudfront:GetKeyGroup",
        "cloudfront:DeleteKeyGroup",
        "cloudfront:GetPublicKey",
        "cloudfront:DeletePublicKey",
        "cloudfront:GetOriginAccessControl",
        "cloudfront:DeleteOriginAccessControl"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudFrontDistributionAndCorsCleanup",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:UpdateDistribution",
        "cloudfront:DeleteDistribution",
        "cloudfront:GetResponseHeadersPolicy",
        "cloudfront:DeleteResponseHeadersPolicy"
      ],
      "Resource": [
        "arn:aws:cloudfront::586481704097:distribution/*",
        "arn:aws:cloudfront::586481704097:response-headers-policy/*"
      ]
    }
  ]
}
