{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Principal": {
        "Service": "scheduler.amazonaws.com"
      },
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "586481704097"
        },
        "ArnEquals": {
          "aws:SourceArn": "arn:aws:scheduler:ap-northeast-1:586481704097:schedule-group/default"
        }
      }
    }
  ]
}
